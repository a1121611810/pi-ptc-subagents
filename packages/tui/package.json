{
  "name": "@pi-ptc/tui",
  "version": "0.0.0",
  "private": true,
  "description": "Display layer: shared text primitives at the root, pi rendering under ./pi",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./pi": {
      "types": "./src/pi/index.ts",
      "default": "./dist/pi.js"
    }
  },
  "scripts": {
    "build": "rolldown -c",
    "check": "tsrs -p tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "1.4.0"
  },
  "devDependencies": {
    "@pi-ptc/dispatch": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.86.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
