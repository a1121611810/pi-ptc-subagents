{
  "name": "@pi-ptc/kimi-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Kimi 面（MCP）：ptc_run_code 的宿主中立形态——node VM 运行格 + 本地 fs 四件套 + workdir 锁",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && rolldown -c",
    "check": "tsrs -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pi-ptc/output": "workspace:*",
    "@pi-ptc/ptc": "workspace:*",
    "@pi-ptc/routes": "workspace:*"
  }
}
