{
  "name": "pi-ptc-subagents",
  "version": "0.1.0",
  "description": "DSH PTC mode (ptc_run_code + ptc_workflow) for pi",
  "keywords": [
    "pi",
    "pi-package",
    "programmatic-tool-calling",
    "ptc"
  ],
  "homepage": "https://github.com/a1121611810/pi-ptc-subagents#readme",
  "bugs": {
    "url": "https://github.com/a1121611810/pi-ptc-subagents/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a1121611810/pi-ptc-subagents.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "pnpm exec tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "pnpm exec vp test --run --coverage",
    "test:watch": "pnpm exec vp test",
    "test:ui": "pnpm exec vp test --ui",
    "verify:dist": "node scripts/verify-dist-render.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run fmt:check && npm run test && npm run build"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.86.1",
    "@earendil-works/pi-coding-agent": "^0.86.1",
    "@earendil-works/pi-tui": "^0.87.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "rolldown": "^1.2.9",
    "rolldown-plugin-dts": "^0.28.6",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2",
    "vite-plus": "0.3.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=0.86.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.5.1",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
