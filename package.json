{
  "name": "pi-ptc-subagents",
  "version": "7.8.0",
  "description": "Programmable tool calling (PTC) and subagent fan-out for pi",
  "keywords": [
    "pi",
    "pi-package",
    "programmable-tool-calling",
    "ptc",
    "subagents"
  ],
  "homepage": "https://github.com/a1121611810/pi-ptc-subagents",
  "bugs": {
    "url": "https://github.com/a1121611810/pi-ptc-subagents/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a1121611810/pi-ptc-subagents.git"
  },
  "bin": {
    "ptc": "./dist/ptc/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "docs/routes/**/*.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./ptc": "./dist/ptc/index.js"
  },
  "scripts": {
    "build": "pnpm -r --filter=!@pi-ptc/website run build",
    "build:kimi": "pnpm --filter @pi-ptc/kimi-mcp run build && node scripts/assemble-kimi.mjs",
    "prepack": "pnpm run build && rm -rf dist docs/routes && cp -R packages/entry/dist dist && cp -R packages/routes/docs/routes docs/routes",
    "check": "pnpm -r --filter=!@pi-ptc/website run check",
    "check:imports": "node scripts/check-artifact-imports.mjs",
    "lint": "oxlint",
    "test": "pnpm run check:imports && pnpm run test:pi && pnpm run test:output && pnpm run test:kimi && pnpm run test:standalone",
    "test:pi": "node --enable-source-maps --test tests/pi/*.test.mjs",
    "test:output": "node --enable-source-maps --test tests/output/*.test.mjs",
    "test:kimi": "node --enable-source-maps --test tests/kimi/*.test.mjs",
    "test:standalone": "node --enable-source-maps --test tests/standalone/*.test.mjs",
    "pretest": "pnpm run build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "rolldown": "^1.2.15",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.86.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.15.0",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
