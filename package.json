{
  "name": "pi-ptc-subagents",
  "version": "0.1.0",
  "description": "DSH PTC mode (ptc_run_code + ptc_workflow) for pi",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "pi-package",
    "pi",
    "ptc",
    "programmatic-tool-calling"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.86.0",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.86.1",
    "@earendil-works/pi-coding-agent": "^0.86.1",
    "@types/node": "^22.0.0",
    "rolldown": "^1.2.9",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a1121611810/pi-ptc-subagents.git"
  },
  "bugs": {
    "url": "https://github.com/a1121611810/pi-ptc-subagents/issues"
  },
  "homepage": "https://github.com/a1121611810/pi-ptc-subagents#readme"
}
