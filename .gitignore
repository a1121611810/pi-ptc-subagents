dist/
coverage/
*.tsbuildinfo
.DS_Store
# 运行时状态（任务记录/产出）：探针与真机冒烟会写，不许入库
.pi/

# 发布产物（npm pack）
*.tgz
# 详情文档的发布副本（源在 packages/routes/docs/routes，pack 时拷到包根）
/docs/routes/

# 站点构建时投影/拷贝的产物（源在仓库文档与 docs/prototypes，canonical 只有一份）
packages/website/docs/
packages/website/public/status/

# ai-memory 长期记忆的 cwd 镜像页（canonical 在 ai-memory 自己的存储里，不许入库）
/concepts/
/gotchas/
/notes/
/decisions/
/sessions/
/procedures/
/_rules/
/_prompts/

# OctoBench 外部基准：数据集与生成的 checklist 都可从 HuggingFace 重下，不入库
bench/octobench/*.jsonl

# A/B 台架跑出来的工件（工作区副本 / 轨迹 / 报告）：可重跑，不入库
bench/ab/out*/
bench/kimi-ab/results*.jsonl
bench/kimi-ab/fixture/
